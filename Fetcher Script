import yfinance as yf
import json
import traceback

def fetch_voo_data():
    try:
        print("🚀 กำลังดึงข้อมูล VOO จาก Yahoo Finance...")
        # 1. ดึงข้อมูล VOO ย้อนหลังตั้งแต่ปี 2015
        ticker = yf.Ticker("VOO")
        # ใช้ history เพื่อดึงข้อมูลรายวัน (Adj Close ถูกนำมาคำนวณใน 'Close' เรียบร้อยแล้ว)
        df = ticker.history(start="2015-01-01")

        if df.empty:
            raise Exception("❌ ไม่พบข้อมูลจาก Yahoo Finance (Data is empty)")

        # รีเซ็ต Index เพื่อให้ใช้งานคอลัมน์ Date ได้ง่ายขึ้น
        df.reset_index(inplace=True)
        
        monthly_data = {}
        
        # 2. แปลงข้อมูลรายวัน (Daily) ให้เป็นข้อมูลสรุปรายเดือน (Monthly)
        for index, row in df.iterrows():
            date_str = row['Date'].strftime('%Y-%m-%d')
            month_label = date_str[:7] # ตัดมาแค่ YYYY-MM
            
            open_p = float(row['Open'])
            high_p = float(row['High'])
            low_p = float(row['Low'])
            close_p = float(row['Close'])

            if month_label not in monthly_data:
                # วันแรกของเดือน
                monthly_data[month_label] = {
                    "date": month_label,
                    "isFirstOfYear": month_label.endswith("-01"),
                    "open": open_p,
                    "high": high_p,
                    "low": low_p,
                    "close": close_p
                }
            else:
                # วันอื่นๆ ในเดือนเดียวกัน อัปเดต High, Low, Close (ของวันล่าสุด)
                monthly_data[month_label]["high"] = max(monthly_data[month_label]["high"], high_p)
                monthly_data[month_label]["low"] = min(monthly_data[month_label]["low"], low_p)
                monthly_data[month_label]["close"] = close_p # จะถูกทับไปเรื่อยๆ จนถึงวันสุดท้ายของเดือน

        # 3. จัดเรียงข้อมูลจาก อดีต -> ปัจจุบัน เสมอ (Chronological Order)
        result = list(monthly_data.values())
        result.sort(key=lambda x: x['date'])

        # 4. บันทึกเป็นไฟล์ JSON เพื่อให้หน้าเว็บ (HTML) เรียกใช้งานได้ไวที่สุด
        with open('voo_data.json', 'w', encoding='utf-8') as f:
            json.dump(result, f, ensure_ascii=False, indent=2)
            
        print(f"✅ สำเร็จ! สร้างไฟล์ voo_data.json จำนวน {len(result)} เดือนเรียบร้อยแล้ว")

    except Exception as e:
        print("❌ เกิดข้อผิดพลาดในการดึงข้อมูล:")
        print(traceback.format_exc())
        exit(1) # บอกให้ GitHub Actions รู้ว่าสคริปต์นี้พัง จะได้แจ้งเตือนเรา

if __name__ == "__main__":
    fetch_voo_data()